<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="TestNGTutorials" parallel="tests" thread-count="6">
    <listeners>
        <listener class-name="A.Listeners"/>
    </listeners>
<!--    <parameter name="URL" value="qaclickacademy.com"/>-->
    <test name="PersonalLoan">
        <classes>
            <class name="day1"/>
            <class name="day2"/>
        </classes>
    </test>
    <test name="CarLoan">
        <parameter name="URL" value="carloan.com"/>
        <parameter name="UserName" value="Shivaprasad"/>
        <classes>
            <class name="day3">
                   <methods>
                       <exclude name="WebLoginCarLoan1"></exclude>
                   </methods>
            </class>
        </classes>
    </test>
    <test name="HomeLoan">
        <parameter name="URL" value="homeloan.com"/>
        <classes>
            <class name="day4">
                <methods>
                    <include name="Mobile.*"></include>
                </methods>
            </class>
        </classes>
    </test>
</suite>